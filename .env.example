# Copy to .env (or export in your shell). All optional: Hookline runs fully without them.

# Natural-language understanding via Claude. Without it, a rule-based parser is used.
ANTHROPIC_API_KEY=
# HOOKLINE_AI=auto            # auto | on | off
# HOOKLINE_AI_MODEL=claude-opus-5-5
# HOOKLINE_AI_TIMEOUT_MS=12000

# YouTube Data API v3 key: enables "Search YouTube" in the Studio (link import works without it).
YOUTUBE_API_KEY=

# Protect Studio write endpoints (hook edits, imports) with a shared key.
HOOKLINE_STUDIO_KEY=

# Public base URL for guest join links/QR (otherwise the server's LAN IP is used).
# PUBLIC_URL=https://party.example.com
# PORT=8787
# HOOKLINE_DB=./data/hookline.db
